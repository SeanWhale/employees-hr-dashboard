# ==========================================
# 1. Python & 虚拟环境
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# 虚拟环境目录 (涵盖常见的命名)
venv/
venv2/
.venv/
env/
.env_python/

# ==========================================
# 2. 数据库与本地存储文件 (DuckDB 特有)
# ==========================================
# DuckDB 会在运行时产生 .duckdb 和 .wal (Write-Ahead Log) 文件
*.duckdb
*.duckdb.wal
*.db
*.sqlite
*.sqlite3

# ==========================================
# 3. 大体量数据文件 (ETL Pipeline)
# ==========================================
# 忽略 dump 和 parquet 文件，防止 Git 仓库变得异常庞大
data/dump/*.dump
data/dump/*.sql
data/parquet/*.parquet
data/processed/parquet/*.parquet

# 忽略 ETL 自动生成的质量报告
data/processed/data_quality_report.json

# (可选) 如果你希望 Git 追踪 data 目录结构但不追踪里面的文件，
# 可以在空目录下放置一个 .gitkeep 文件，这里特意排除了 .gitkeep
!data/**/.gitkeep

# ==========================================
# 4. 前端与 Node.js (预防未来引入 npm)
# ==========================================
node_modules/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ⚠️ 明确保留前端的地图依赖文件 (不要被上面的 json 规则误杀)
!frontend/data/china_geo.json

# ==========================================
# 5. 环境变量与机密配置
# ==========================================
.env
.env.*
!.env.example

# ==========================================
# 6. IDE 与 操作系统缓存
# ==========================================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db